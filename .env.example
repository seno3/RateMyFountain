# Copy to .env.local and fill in. Never commit .env.local.

# Supabase project URL and publishable key. Both are public (they ship to the browser);
# Row Level Security is what protects the data.
# Local: run `pnpm exec supabase status` and copy API_URL and PUBLISHABLE_KEY.
# Production: Supabase dashboard -> Project Settings -> API Keys.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Optional. A Mapbox public token (starts with pk.) adds a "Satellite" style to the map.
# The map works without it (base maps come from OpenFreeMap). https://account.mapbox.com/access-tokens/
NEXT_PUBLIC_MAPBOX_TOKEN=
